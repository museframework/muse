<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         child.project.url.inherit.append.path="false"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.museframework</groupId>
        <artifactId>muse-bom</artifactId>
        <version>0.1.0</version>
        <relativePath>muse-bom/pom.xml</relativePath>
    </parent>

    <artifactId>muse-parent</artifactId>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.code.style>official</kotlin.code.style>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <muse.failsafe.test-pattern>**/*IT.java, !**/*NativeIT.java</muse.failsafe.test-pattern>
    </properties>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Muse - Kotlin-based integration framework inspired by MuleSoft</description>
    <url>https://github.com/museframework/muse</url>

    <licenses>
        <license>
            <name>Sustainable Use License</name>
            <url>https://github.com/museframework/muse/blob/main/LICENSE.md</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>gbartoloni</id>
            <name>Giacomo Bartoloni</name>
            <email>gbartoloni@proton.me</email>
            <organization>Muse Framework</organization>
            <organizationUrl>https://github.com/museframework</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/museframework/muse.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/museframework/muse.git</developerConnection>
        <url>https://github.com/museframework/muse/tree/main</url>
    </scm>

    <modules>
        <module>muse-bom</module>
        <module>muse-dsl</module>
        <module>muse-engine-api</module>
        <module>muse-engine-scala</module>
        <module>muse-engine</module>
        <module>muse-engine/src/test/fixtures/policy-extension</module>

        <!-- Spring Boot integration projects -->
        <module>muse-spring-boot</module>

        <!-- Connectors -->
        <module>muse-http</module>
        <module>muse-sftp-connector-api</module>
        <module>muse-sftp-connector-testkit</module>
        <module>muse-sftp-connector</module>
        <module>muse-sftp-babelfish-mappers</module>
        <module>muse-db-connector-api</module>
        <module>muse-db-connector</module>

        <module>muse-file-connector-api</module>
        <module>muse-file-connector</module>
        <module>muse-file-babelfish-mappers</module>

        <module>muse-apikit-connector-api</module>
        <module>muse-apikit-connector</module>
        <module>muse-apikit-connector-spring</module>

        <!-- Babelfish -->
        <module>muse-babelfish</module>
        <module>muse-babelfish-core-mappers</module>
        <module>muse-apikit-babelfish-mappers</module>
        <module>muse-db-babelfish-mappers</module>

        <!-- Maven Plugin -->
        <module>muse-maven-plugin</module>
        <module>muse-file-plugin-it</module>
        <module>muse-db-plugin-it</module>
        <module>muse-sftp-plugin-it</module>

        <!-- Example projects -->
        <module>examples</module>

        <!-- Packaged acceptance tests -->
        <module>muse-packaged-test-parent</module>
        <module>muse-packaged-e2e-testkit</module>
        <module>muse-packaged-e2e</module>
        <module>muse-sftp-packaged-e2e</module>
        <module>muse-db-packaged-e2e</module>
        <module>muse-file-packaged-e2e</module>
        <module>muse-connector-composition-e2e</module>

        <!-- Architecture Tests -->
        <module>muse-architecture-tests</module>
    </modules>

        <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
            <!-- Central Portal Publisher Plugin must be an active build extension. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <skipPublishing>${skipPublishing}</skipPublishing>
                    <!-- Publication requires explicit approval in Central Portal after validation. -->
                    <autoPublish>false</autoPublish>
                    <deploymentName>${project.artifactId}-${project.version}</deploymentName>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals><goal>test-compile</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*E2ETest.java</exclude>
                        <exclude>**/*FuzzTest.java</exclude>
                        <exclude>**/*PerformanceTest.java</exclude>
                        <exclude>**/*NativeIT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>${muse.failsafe.test-pattern}</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>net.alchim31.maven</groupId>
                    <artifactId>scala-maven-plugin</artifactId>
                    <version>${scala-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>e2e</id>
            <properties>
                <muse.failsafe.test-pattern>**/*E2ETest.java</muse.failsafe.test-pattern>
            </properties>
        </profile>
        <profile>
            <id>fuzz</id>
            <properties>
                <muse.failsafe.test-pattern>**/*FuzzTest.java</muse.failsafe.test-pattern>
            </properties>
        </profile>
        <profile>
            <id>performance</id>
            <properties>
                <muse.failsafe.test-pattern>**/*PerformanceTest.java</muse.failsafe.test-pattern>
            </properties>
        </profile>
        <profile>
            <id>native-it</id>
            <properties>
                <muse.failsafe.test-pattern>**/*NativeIT.java</muse.failsafe.test-pattern>
            </properties>
        </profile>
    </profiles>

</project>
