<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <db:config name="database-config" doc:name="Database Config">
        <db:generic-connection url="jdbc:postgresql://localhost/orders"
                               driverClassName="org.postgresql.Driver"
                               user="muse"
                               password="${db.password}"
                               transactionIsolation="READ_COMMITTED">
            <db:connection-properties>
                <db:property key="sslmode" value="require"/>
            </db:connection-properties>
        </db:generic-connection>
    </db:config>

    <flow name="database-operations">
        <db:select config-ref="database-config" fetchSize="25" maxRows="100" doc:name="Select rows">
            <db:sql>SELECT id, name FROM account WHERE id = :id</db:sql>
            <db:input-parameters><![CDATA[#[{ id: payload }]]]></db:input-parameters>
            <db:parameter-types>
                <db:parameter-type key="id" type="BIGINT"/>
            </db:parameter-types>
        </db:select>
        <db:query-single config-ref="database-config"><db:sql>SELECT id FROM account WHERE id = :id</db:sql></db:query-single>
        <db:insert config-ref="database-config" autoGenerateKeys="true" autoGeneratedKeysColumnNames="id"><db:sql>INSERT INTO account(name) VALUES (:name)</db:sql></db:insert>
        <db:update config-ref="database-config"><db:sql>UPDATE account SET name = :name WHERE id = :id</db:sql></db:update>
        <db:delete config-ref="database-config"><db:sql>DELETE FROM account WHERE id = :id</db:sql></db:delete>
        <db:bulk-insert config-ref="database-config"><db:sql>INSERT INTO account(id, name) VALUES (:id, :name)</db:sql></db:bulk-insert>
        <db:bulk-update config-ref="database-config"><db:sql>UPDATE account SET name = :name WHERE id = :id</db:sql></db:bulk-update>
        <db:bulk-delete config-ref="database-config"><db:sql>DELETE FROM account WHERE id = :id</db:sql></db:bulk-delete>
        <db:execute-ddl config-ref="database-config"><db:sql>CREATE TABLE audit (id BIGINT)</db:sql></db:execute-ddl>
        <db:execute-script config-ref="database-config"><db:sql>INSERT INTO audit(id) VALUES (1); INSERT INTO audit(id) VALUES (2);</db:sql></db:execute-script>
        <db:stored-procedure config-ref="database-config">
            <db:sql>{ call add_values(:left_value, :result) }</db:sql>
            <db:input-parameters><![CDATA[#[{ left_value: 4 }]]]></db:input-parameters>
            <db:in-out-parameters><![CDATA[#[{ result: 3 }]]]></db:in-out-parameters>
            <db:output-parameters>
                <db:output-parameter key="result" type="INTEGER"/>
            </db:output-parameters>
        </db:stored-procedure>
    </flow>

    <flow name="database-listener">
        <db:listener config-ref="database-config" table="outbox" watermarkColumn="id" idColumn="id" doc:name="Outbox listener">
            <scheduling-strategy>
                <fixed-frequency frequency="5" timeUnit="SECONDS"/>
            </scheduling-strategy>
        </db:listener>
        <db:query-single config-ref="database-config"><db:sql>SELECT 1 AS processed</db:sql></db:query-single>
    </flow>
</mule>
