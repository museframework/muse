<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.museframework.it</groupId>
    <artifactId>duplicate-mapper-owners</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-babelfish</artifactId>
            <version>0.3.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.museframework.maven</groupId>
                <artifactId>muse-maven-plugin</artifactId>
                <version>0.3.0-SNAPSHOT</version>
                <dependencies>
                    <!-- The first Invoker execution installs this project's provider JAR. -->
                    <dependency>
                        <groupId>dev.museframework.it</groupId>
                        <artifactId>duplicate-mapper-owners</artifactId>
                        <version>1.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
