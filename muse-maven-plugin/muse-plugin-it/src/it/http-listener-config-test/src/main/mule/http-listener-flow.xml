<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
  <http:listener-config name="http-listener-config" doc:name="HTTP Listener Config">
    <http:listener-connection host="0.0.0.0" port="8081"/>
  </http:listener-config>
  
  <flow name="http-listener-flow" doc:name="HTTP Listener Test">
    <http:listener config-ref="http-listener-config" path="/test" doc:name="HTTP Listener"/>
    <set-payload value="HTTP Response" doc:name="Set Response"/>
    <logger message="#[payload]" level="INFO" doc:name="Log Response"/>
  </flow>
</mule>
