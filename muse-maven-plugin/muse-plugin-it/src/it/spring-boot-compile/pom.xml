<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.museframework.it</groupId>
    <artifactId>spring-boot-compile</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipPublishing>true</skipPublishing>
        <maven.deploy.skip>true</maven.deploy.skip>
        <kotlin.version>2.3.20</kotlin.version>
        <kotlin.daemon.enabled>false</kotlin.daemon.enabled>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-dsl</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-babelfish</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-spring-boot</artifactId>
            <version>0.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                    <args>
                        <arg>-Xskip-runtime-version-check</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals><goal>compile</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>dev.museframework.maven</groupId>
                <artifactId>muse-maven-plugin</artifactId>
                <version>0.1.0</version>
                <executions>
                    <execution>
                        <id>muse-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <packageName>dev.museframework.it.spring</packageName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
