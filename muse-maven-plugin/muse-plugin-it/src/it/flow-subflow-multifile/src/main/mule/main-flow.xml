<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
  <!-- Main flow that references subflows from other files -->
  <flow name="main-flow" doc:name="Main Flow">
    <set-payload value="Starting main flow" doc:name="Set Initial Payload"/>
    <logger message="Starting main flow" level="INFO" doc:name="Log Start"/>
    
    <!-- Call subflow from helpers.xml -->
    <flow-ref name="validate-input-subflow" doc:name="Call Validate Input"/>
    
    <!-- Call subflow from processors.xml -->
    <flow-ref name="process-data-subflow" doc:name="Call Process Data"/>
    
    <!-- Call subflow from helpers.xml -->
    <flow-ref name="format-output-subflow" doc:name="Call Format Output"/>
    
    <logger message="#[payload]" level="INFO" doc:name="Log Final Result"/>
  </flow>
</mule>
