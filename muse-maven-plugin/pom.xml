<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.museframework</groupId>
        <artifactId>muse-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>dev.museframework.maven</groupId>
    <artifactId>muse-maven-plugin-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Muse Maven Plugin — Parent</name>

    <modules>
        <module>muse-plugin-core</module>
        <module>muse-maven-plugin</module>
        <module>muse-plugin-it</module>
    </modules>

  <properties>
    <!-- Inherited from muse-parent: kotlin, junit-jupiter, mockk, groovy -->
    <maven.plugin.api.version>3.9.6</maven.plugin.api.version>
    <maven.plugin.tools.version>3.9.0</maven.plugin.tools.version>
    <mojo.executor.version>2.4.0</mojo.executor.version>
  </properties>

  <repositories>
    <repository>
      <id>maven-central</id>
      <url>https://repo1.maven.org/maven2/</url>
    </repository>
    <repository>
      <id>mulesoft-public</id>
      <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
    </repository>
  </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Muse modules -->
            <dependency>
                <groupId>dev.museframework</groupId>
                <artifactId>muse-dsl</artifactId>
                <version>${muse.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.museframework</groupId>
                <artifactId>muse-babelfish</artifactId>
                <version>${muse.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.museframework</groupId>
                <artifactId>muse-babelfish-core-mappers</artifactId>
                <version>${muse.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.museframework</groupId>
                <artifactId>muse-http-babelfish-mappers</artifactId>
                <version>${muse.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.museframework</groupId>
                <artifactId>muse-apikit-babelfish-mappers</artifactId>
                <version>${muse.version}</version>
            </dependency>
            <!-- Maven plugin API -->
            <dependency>
                <groupId>org.apache.maven</groupId>
                <artifactId>maven-plugin-api</artifactId>
                <version>${maven.plugin.api.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.maven.plugin-tools</groupId>
                <artifactId>maven-plugin-annotations</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.maven</groupId>
                <artifactId>maven-core</artifactId>
                <version>${maven.plugin.api.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- mojo-executor for delegating to other plugins -->
            <dependency>
                <groupId>org.twdata.maven</groupId>
                <artifactId>mojo-executor</artifactId>
                <version>${mojo.executor.version}</version>
            </dependency>
            <!-- Test -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-test</artifactId>
                <version>${kotlin.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.mockk</groupId>
                <artifactId>mockk-jvm</artifactId>
                <version>${mockk.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy.version}</version>

            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>${maven.plugin.tools.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-invoker-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
