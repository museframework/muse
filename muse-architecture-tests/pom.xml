<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.museframework</groupId>
        <artifactId>muse-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>muse-architecture-tests</artifactId>
    <packaging>jar</packaging>
    <name>Muse Architecture Tests</name>
    <description>Architecture constraint tests using ArchUnit to enforce clean architecture rules</description>

    <properties>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <skipPublishing>true</skipPublishing>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Muse modules (test scope) -->
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-dsl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-engine-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-http-connector-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-http-connector</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-sftp-connector-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-db-connector-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-file-connector-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-sftp-connector</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-sftp-connector-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-sftp-babelfish-mappers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-db-connector</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-file-connector</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-spring-boot</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-http-connector-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-apikit-connector</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          The neutral external policy extension fixture (production dependencies: muse-dsl and
          muse-engine-api only). It is on the test classpath so the architecture rules can prove that
          extension production code carries no engine implementation dependency.
        -->
        <dependency>
            <groupId>dev.museframework.test</groupId>
            <artifactId>muse-policy-extension-fixture</artifactId>
            <version>0.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-babelfish</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-babelfish-core-mappers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-apikit-babelfish-mappers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-http-babelfish-mappers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-db-babelfish-mappers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-file-babelfish-mappers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.museframework.maven</groupId>
            <artifactId>muse-plugin-core</artifactId>
            <version>0.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
