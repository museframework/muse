<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
  <sftp:config name="Sftp_Config" doc:name="SFTP Config">
    <sftp:connection host="127.0.0.1"
                     port="${sftp.port}"
                     username="muse"
                     password="secret"
                     workingDir="/data"/>
  </sftp:config>

  <flow name="sftp-write-read-flow" doc:name="SFTP Write Read">
    <set-payload value="round-trip" doc:name="Seed payload"/>
    <set-variable variableName="mode" value="OVERWRITE"/>
    <sftp:write config-ref="Sftp_Config"
                path="/outbound/request.bin"
                mode="#[vars.mode]"
                createParentDirectories="true"
                doc:name="Write">
      <sftp:content><![CDATA[#[payload]]]></sftp:content>
    </sftp:write>
    <sftp:read config-ref="Sftp_Config" path="/outbound/request.bin" doc:name="Read"/>
  </flow>
  <flow name="streaming-csv-resource-flow">
    <sftp:listener config-ref="Sftp_Config" outputMimeType="application/csv; streaming=true; header=true">
      <non-repeatable-stream/>
    </sftp:listener>
    <foreach batchSize="${batch.size}">
      <ee:transform>
        <ee:message>
          <ee:set-payload resource="dataweave/to-text.dwl"/>
        </ee:message>
      </ee:transform>
      <sftp:write config-ref="Sftp_Config" path="/outbound/rows.txt"/>
    </foreach>
  </flow>
</mule>
