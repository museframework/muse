<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:file="http://www.mulesoft.org/schema/mule/file">
    <file:config name="output">
        <file:connection workingDir="/tmp/muse-file"/>
    </file:config>
    <flow name="load-state">
        <file:read config-ref="output" path="state.json" target="stateText" outputMimeType="text/plain"/>
    </flow>
</mule>
