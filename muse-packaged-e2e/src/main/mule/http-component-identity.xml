<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
    <http:listener-config name="http-identity-listener" doc:name="HTTP identity listener">
        <http:listener-connection host="127.0.0.1" port="0"/>
    </http:listener-config>
    <http:request-config name="http-identity-request" doc:name="HTTP identity request">
        <http:request-connection host="api.example.test"/>
    </http:request-config>
    <flow name="http-component-identity" doc:id="http-flow-identity">
        <http:listener config-ref="http-identity-listener" path="/identity" doc:id="http-listener-identity"/>
        <http:request config-ref="http-identity-request" path="/first" method="POST" doc:id="http-request-first"/>
        <http:request config-ref="http-identity-request" path="/second" method="PATCH" doc:id="http-request-&quot;second&quot;-$"/>
    </flow>
</mule>
