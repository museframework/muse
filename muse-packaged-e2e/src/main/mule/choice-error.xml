<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <flow name="packaged-choice-error-flow" doc:id="packaged-choice-error-flow">
        <http:listener config-ref="packaged-listener" path="/e2e/choice-error" allowedMethods="POST" doc:name="Choice listener"/>
        <choice doc:name="Choose outcome">
            <when expression="#[payload == &quot;fail&quot;]">
                <raise-error type="MULE:EXPRESSION" description="Expected packaged E2E failure" doc:name="Raise expected error"/>
            </when>
            <otherwise>
                <set-payload value="Choice success" doc:name="Set success response"/>
            </otherwise>
        </choice>
        <error-handler>
            <on-error-continue type="MULE:EXPRESSION" doc:name="Handle expected error">
                <set-payload value="Choice error handled" doc:name="Set handled response"/>
            </on-error-continue>
        </error-handler>
    </flow>
</mule>
