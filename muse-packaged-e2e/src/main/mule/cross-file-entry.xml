<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <flow name="packaged-cross-file-flow" doc:id="packaged-cross-file-flow">
        <http:listener config-ref="packaged-listener" path="/e2e/cross-file" allowedMethods="POST" doc:name="Cross-file listener"/>
        <flow-ref name="packaged-cross-file-subflow" doc:name="Invoke cross-file sub-flow"/>
    </flow>
</mule>
