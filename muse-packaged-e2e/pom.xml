<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.museframework.test</groupId>
        <artifactId>muse-packaged-test-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../muse-packaged-test-parent/pom.xml</relativePath>
    </parent>

    <groupId>dev.museframework</groupId>
    <artifactId>muse-packaged-e2e</artifactId>
    <version>0.1.0</version>
    <name>Muse Packaged E2E Fixture</name>
    <description>Generated Kotlin compilation and packaged application boundary</description>

    <properties>
        <muse.generated.package>dev.museframework.e2e.packaged.generated</muse.generated.package>
        <muse.packaged.main-class>${muse.generated.package}.MusePackagedE2eApplicationKt</muse.packaged.main-class>
        <muse.verification.kind>platform</muse.verification.kind>
        <muse.verification.family>platform</muse.verification.family>
        <muse.verification.codegen>true</muse.verification.codegen>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-spring-boot</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-http-connector-spring</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!--
          The neutral external policy extension fixture: production dependencies are only muse-dsl and
          muse-engine-api, and its MuseComponentRegistrar is discovered from this JAR on the packaged
          classpath. It is loaded by the packaged application, so the packaged process evidence is the
          external registration proof for S07/S26.
        -->
        <dependency>
            <groupId>dev.museframework.test</groupId>
            <artifactId>muse-policy-extension-fixture</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.museframework.test</groupId>
            <artifactId>muse-packaged-e2e-testkit</artifactId>
            <version>0.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.museframework.maven</groupId>
                <artifactId>muse-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-muse-application</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>dev.museframework</groupId>
                        <artifactId>muse-http-babelfish-mappers</artifactId>
                        <version>0.1.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
