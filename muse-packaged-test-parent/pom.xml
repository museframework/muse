<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/>
    </parent>

    <groupId>dev.museframework.test</groupId>
    <artifactId>muse-packaged-test-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Muse Packaged Test Parent</name>
    <description>Shared packaged fixture build configuration without connector dependencies</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.museframework</groupId>
                <artifactId>muse-bom</artifactId>
                <version>0.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.3.20</kotlin.version>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <kotlin.daemon.enabled>false</kotlin.daemon.enabled>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <muse.failsafe.test-pattern>**/*IT.java, !**/*NativeIT.java</muse.failsafe.test-pattern>
        <skipPublishing>true</skipPublishing>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>dev.museframework.maven</groupId>
                    <artifactId>muse-maven-plugin</artifactId>
                    <version>0.1.0</version>
                    <configuration>
                        <packageName>${muse.generated.package}</packageName>
                        <runtime>spring-boot</runtime>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <configuration>
                        <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                        </args>
                        <compilerPlugins>
                            <plugin>spring</plugin>
                        </compilerPlugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-allopen</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <mainClass>${muse.packaged.main-class}</mainClass>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                            <exclude>**/*E2ETest.java</exclude>
                            <exclude>**/*FuzzTest.java</exclude>
                            <exclude>**/*PerformanceTest.java</exclude>
                            <exclude>**/*NativeIT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <failIfNoTests>true</failIfNoTests>
                        <includes>
                            <include>${muse.failsafe.test-pattern}</include>
                        </includes>
                        <systemPropertyVariables>
                            <packaged.e2e.jar>${project.build.directory}/${project.build.finalName}.jar</packaged.e2e.jar>
                            <packaged.e2e.log>${project.build.directory}/packaged-e2e/application.log</packaged.e2e.log>
                            <packaged.e2e.port>18080</packaged.e2e.port>
                        </systemPropertyVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>e2e</id>
            <properties>
                <muse.failsafe.test-pattern>**/*IT.java, **/*E2ETest.java, !**/*NativeIT.java</muse.failsafe.test-pattern>
            </properties>
        </profile>
    </profiles>
</project>
