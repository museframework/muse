<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.museframework.test</groupId>
        <artifactId>muse-packaged-test-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../muse-packaged-test-parent/pom.xml</relativePath>
    </parent>

    <groupId>dev.museframework</groupId>
    <artifactId>muse-db-packaged-e2e</artifactId>
    <version>0.1.0</version>
    <name>Muse DB Packaged E2E Fixture</name>
    <description>Independently packaged database runtime and generated acceptance</description>

    <properties>
        <muse.generated.package>dev.museframework.e2e.db.generated</muse.generated.package>
        <muse.packaged.main-class>${muse.generated.package}.MuseDbPackagedE2eApplicationKt</muse.packaged.main-class>
        <muse.verification.kind>packaged</muse.verification.kind>
        <muse.verification.family>db</muse.verification.family>
        <muse.verification.codegen>true</muse.verification.codegen>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-spring-boot</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-http-connector-spring</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>dev.museframework.connectors</groupId>
            <artifactId>muse-db-connector</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.museframework.test</groupId>
            <artifactId>muse-packaged-e2e-testkit</artifactId>
            <version>0.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.museframework.maven</groupId>
                <artifactId>muse-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-muse-application</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>dev.museframework</groupId>
                        <artifactId>muse-http-babelfish-mappers</artifactId>
                        <version>0.1.0</version>
                    </dependency>
                    <dependency>
                        <groupId>dev.museframework</groupId>
                        <artifactId>muse-db-babelfish-mappers</artifactId>
                        <version>0.1.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <packaged.e2e.jar>${project.build.directory}/${project.build.finalName}.jar</packaged.e2e.jar>
                        <packaged.e2e.log>${project.build.directory}/packaged-e2e/application.log</packaged.e2e.log>
                        <packaged.e2e.port>18081</packaged.e2e.port>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
