<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:meta="http://www.mulesoft.org/schema/mule/documentation">

    <sftp:config name="Sftp_Config" doc:name="SFTP Config" meta:id="sftp-connection-original">
        <sftp:connection host="sftp.example.com"
                         port="2222"
                         username="muse"
                         password="secret"
                         workingDir="/data"
                         knownHostsFile="/etc/muse/known_hosts"
                         connectionTimeout="15"
                         connectionTimeoutUnit="SECONDS"
                         responseTimeout="45"
                         responseTimeoutUnit="SECONDS"/>
    </sftp:config>

    <flow name="sftp-provider-flow" doc:id="flow-id">
        <sftp:listener config-ref="Sftp_Config"
                       doc:id="poll-$id" doc:name="CSV &quot;poll&quot;"
                       directory="inbox"
                       recursive="false"
                       watermarkEnabled="true"
                       autoDelete="false"
                       moveToDirectory="archive"
                       overwrite="true"
                       applyPostActionWhenFailed="false"
                       timeBetweenSizeCheck="10"
                       timeBetweenSizeCheckUnit="MILLISECONDS">
            <scheduling-strategy>
                <fixed-frequency frequency="2000"/>
            </scheduling-strategy>
            <sftp:matcher filenamePattern="*.csv" maxSize="100"/>
        </sftp:listener>

        <sftp:read config-ref="Sftp_Config" path="inbox/input.csv" doc:id="sftp-read-original"/>

        <sftp:write config-ref="Sftp_Config"
                    path="outbox/output.csv"
                    mode="APPEND"
                    doc:id="sftp-write-original"
                    createParentDirectories="true">
            <sftp:content>#[payload]</sftp:content>
        </sftp:write>

        <sftp:list config-ref="Sftp_Config"
                   directoryPath="inbox"
                   recursive="true"
                   doc:id="sftp-list-original">
            <sftp:matcher filenamePattern="*.csv" maxSize="100"/>
        </sftp:list>

        <sftp:copy config-ref="Sftp_Config"
                   sourcePath="inbox/input.csv"
                   targetPath="copies"
                   createParentDirectories="true"
                   overwrite="true"
                   doc:id="sftp-copy-original"
                   renameTo="copied.csv"/>

        <sftp:move config-ref="Sftp_Config"
                   sourcePath="inbox/staging.csv"
                   targetPath="moved"
                   createParentDirectories="false"
                   overwrite="false"
                   doc:id="sftp-move-original"/>

        <sftp:delete config-ref="Sftp_Config" path="inbox/obsolete.csv" doc:id="sftp-delete-original"/>

        <sftp:rename config-ref="Sftp_Config"
                     path="inbox/old-name.csv"
                     to="new-name.csv"
                     doc:id="sftp-rename-original"
                     overwrite="true"/>

        <sftp:create-directory config-ref="Sftp_Config" directoryPath="inbox/created" doc:id="sftp-create-directory-original"/>

        <sftp:write config-ref="Sftp_Config"
                    path="outbox/secondary.csv"
                    meta:id="sftp-write-&quot;secondary&quot;-$batch">
            <sftp:content>#[payload]</sftp:content>
        </sftp:write>
    </flow>
</mule>
