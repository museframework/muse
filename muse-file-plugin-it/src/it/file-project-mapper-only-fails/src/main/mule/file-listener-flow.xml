<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:file="http://www.mulesoft.org/schema/mule/file"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
  <file:config name="File_Config" doc:name="File Config">
    <file:connection workingDir="/tmp/muse-file"/>
  </file:config>

  <flow name="file-listener-flow" doc:name="File Listener Test">
    <file:listener config-ref="File_Config" directory="inbox" doc:name="File Listener"/>
    <file:read config-ref="File_Config" path="inbox/input.txt" doc:name="Read"/>
    <set-payload value="read" doc:name="Set Response"/>
  </flow>
</mule>
