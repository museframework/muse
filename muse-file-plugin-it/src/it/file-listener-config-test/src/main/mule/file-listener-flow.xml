<?xml version="1.0" encoding="UTF-8"?>
<!-- Archive matching CSV files after the flow. -->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:file="http://www.mulesoft.org/schema/mule/file"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
  <file:config name="File_Config" doc:name="File Config">
    <file:connection workingDir="/tmp/muse-file"/>
  </file:config>

  <flow name="file-listener-flow" doc:name="File Listener Test">
    <file:listener config-ref="File_Config"
                   directory="input"
                   moveToDirectory="output"
                   doc:name="File Listener">
      <scheduling-strategy>
        <fixed-frequency/>
      </scheduling-strategy>
      <file:matcher filenamePattern="*.csv"/>
    </file:listener>
    <set-payload value="archived" doc:name="Set Response"/>
  </flow>
</mule>
