<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.museframework</groupId>
        <artifactId>muse-parent</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>muse-object-store-babelfish-mappers</artifactId>
    <name>Muse Object Store Babelfish Mappers</name>
    <description>Mule Object Store XML translation for the local Muse Object Store connector</description>
    <dependencies>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-babelfish</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-dsl</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.museframework</groupId>
            <artifactId>muse-object-store-connector-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>ban-object-store-runtime-dependency</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>dev.museframework.connectors:muse-object-store-connector:*</exclude>
                                        <exclude>dev.museframework:muse-object-store-connector:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>
                                        Object Store mappers must depend on the public API, never the runtime connector.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
