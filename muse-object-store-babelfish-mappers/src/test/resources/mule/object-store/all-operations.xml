<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
    <os:object-store name="named" config-ref="locks" persistent="false" maxEntries="10"
                     entryTtl="2" entryTtlUnit="MINUTES" expirationInterval="5" expirationIntervalUnit="SECONDS"/>
    <os:config name="locks" lockTimeout="50" lockTimeoutUnit="MILLISECONDS"><os:connection/></os:config>
    <flow name="object-store-contract">
        <os:clear/>
        <os:store key="one" objectStore="named" failIfPresent="true" failOnNullValue="false" doc:name="Save">
            <os:value><![CDATA[#[%dw 2.0
output application/json
---
payload]]]></os:value>
        </os:store>
        <os:contains key="one" objectStore="named" target="exists"/>
        <os:retrieve key="missing" objectStore="named" target="found" targetValue="#[payload]">
            <os:default-value><![CDATA[#[%dw 2.0
---
{ fallback: true }]]]></os:default-value>
        </os:retrieve>
        <os:retrieve-all objectStore="named"/>
        <os:retrieve-all-keys objectStore="named"/>
        <os:remove key="one" objectStore="named"/>
    </flow>
</mule>
